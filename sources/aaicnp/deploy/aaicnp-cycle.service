# /etc/systemd/system/aaicnp-cycle.service
[Unit]
Description=Nepal AAIC (CAAN) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaicnp
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaicnp/aaicnp-cycle.log
StandardError=append:/opt/aaicnp/aaicnp-cycle.log
TimeoutStartSec=10800
