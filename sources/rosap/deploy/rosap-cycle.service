# /etc/systemd/system/rosap-cycle.service
[Unit]
Description=ROSA P CAB collection ingest cycle (quarterly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/rosap
# Chrome under Xvfb: Akamai refuses every non-browser client, so there is no
# headless-http path for this source.
ExecStart=/bin/bash -c "xvfb-run -a deploy/run-cycle.sh"
StandardOutput=append:/opt/rosap/rosap-cycle.log
StandardError=append:/opt/rosap/rosap-cycle.log
TimeoutStartSec=21600

# ── sandboxing ───────────────────────────────────────────────────────────────
# This unit used to be `/bin/bash -lc`. A LOGIN shell sources ~/.profile and
# friends, so anything that could write the scraper user's home got code
# execution on the next timer tick — and this box stores scraped data under
# that same home. `-c` reads no profile.
#
# ProtectSystem=full (not strict) is deliberate: strict makes the whole
# filesystem read-only and would need an explicit ReadWritePaths for both
# WorkingDirectory and the per-source ~/<code>-ingest data directory. That
# pair has not been verified on the live host, and getting it wrong fails
# every timer. `full` covers /usr, /boot and /etc while leaving the data
# paths writable.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
