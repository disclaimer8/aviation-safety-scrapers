# /etc/systemd/system/rosap-cycle.timer
#
# The corpus is closed — Civil Aeronautics Board reports end in 1965 — so this
# only ever picks up newly digitized scans. Quarterly is generous for that.
[Unit]
Description=Quarterly ROSA P CAB collection ingest

[Timer]
OnCalendar=*-01,04,07,10-14 03:20 UTC
Persistent=true
RandomizedDelaySec=1800

[Install]
WantedBy=timers.target
