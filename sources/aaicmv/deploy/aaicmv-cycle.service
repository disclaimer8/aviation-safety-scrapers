# /etc/systemd/system/aaicmv-cycle.service
[Unit]
Description=AAIC Maldives (AICC) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaicmv
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaicmv/aaicmv-cycle.log
StandardError=append:/opt/aaicmv/aaicmv-cycle.log
TimeoutStartSec=10800
