# /etc/systemd/system/aaiubg-cycle.service
[Unit]
Description=Bulgaria AAIU (aaiubg) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaiubg
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaiubg/aaiubg-cycle.log
StandardError=append:/opt/aaiubg/aaiubg-cycle.log
TimeoutStartSec=10800
