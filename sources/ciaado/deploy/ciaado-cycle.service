# /etc/systemd/system/ciaado-cycle.service
[Unit]
Description=CIAA (Dominican Republic) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=%h/ciaado-ingest
ExecStart=/bin/bash -c "deploy/run-cycle.sh"
StandardOutput=append:%h/ciaado-ingest/ciaado-cycle.log
StandardError=append:%h/ciaado-ingest/ciaado-cycle.log
TimeoutStartSec=10800

# ── sandboxing ───────────────────────────────────────────────────────────────
# This unit used to be `/bin/bash -lc`. A LOGIN shell sources ~/.profile and
# friends, so anything able to write the scraper user's home got code execution
# on the next timer tick. `-c` reads no profile.
NoNewPrivileges=true
PrivateTmp=true
# strict: the whole filesystem is read-only except what is listed below.
#
# The paths here were /opt/<code>, which is not where anything runs. Checked
# against the mini-PC on 2026-09-11: all 77 deployed units use
# %h/<code>-ingest and none uses /opt. %h follows User= rather than hardcoding
# one operator's home.
ProtectSystem=strict
ReadWritePaths=%h/ciaado-ingest
# ssh writes known_hosts on first connect when OCR_REMOTE is set. The leading
# '-' makes this tolerant of the directory not existing.
ReadWritePaths=-%h/.ssh
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
