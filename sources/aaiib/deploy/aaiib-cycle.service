# /etc/systemd/system/aaiib-cycle.service
[Unit]
Description=AAIIB (Philippines) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaiib
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaiib/aaiib-cycle.log
StandardError=append:/opt/aaiib/aaiib-cycle.log
TimeoutStartSec=10800
