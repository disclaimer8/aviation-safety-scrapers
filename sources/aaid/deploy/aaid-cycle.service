# /etc/systemd/system/aaid-cycle.service
[Unit]
Description=AAID (Kenya) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaid
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaid/aaid-cycle.log
StandardError=append:/opt/aaid/aaid-cycle.log
TimeoutStartSec=10800
