# /etc/systemd/system/aaisl-cycle.service
[Unit]
Description=AAII Sri Lanka (CAA Sri Lanka) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaisl
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaisl/aaisl-cycle.log
StandardError=append:/opt/aaisl/aaisl-cycle.log
TimeoutStartSec=10800
