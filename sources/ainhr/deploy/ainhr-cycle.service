# /etc/systemd/system/ainhr-cycle.service
[Unit]
Description=AIN.HR (Croatia) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/ainhr
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/ainhr/ainhr-cycle.log
StandardError=append:/opt/ainhr/ainhr-cycle.log
TimeoutStartSec=10800
