# /etc/systemd/system/aicpng-cycle.service
[Unit]
Description=AIC PNG (Papua New Guinea) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aicpng
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aicpng/aicpng-cycle.log
StandardError=append:/opt/aicpng/aicpng-cycle.log
TimeoutStartSec=10800
