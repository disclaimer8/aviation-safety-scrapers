# /etc/systemd/system/gcaagy-cycle.service
[Unit]
Description=GCAA (Guyana) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/gcaagy
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/gcaagy/gcaagy-cycle.log
StandardError=append:/opt/gcaagy/gcaagy-cycle.log
TimeoutStartSec=10800
