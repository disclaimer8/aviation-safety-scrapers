# /etc/systemd/system/aaibmn-cycle.service
[Unit]
Description=Mongolia AAIB ingest cycle (weekly; DE-SOCKS discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaibmn
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaibmn/aaibmn-cycle.log
StandardError=append:/opt/aaibmn/aaibmn-cycle.log
TimeoutStartSec=10800
