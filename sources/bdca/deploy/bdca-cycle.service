# /etc/systemd/system/bdca-cycle.service
[Unit]
Description=Belize DCA / BAAI ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/bdca
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/bdca/bdca-cycle.log
StandardError=append:/opt/bdca/bdca-cycle.log
TimeoutStartSec=10800
