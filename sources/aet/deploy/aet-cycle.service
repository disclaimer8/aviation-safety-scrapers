# /etc/systemd/system/aet-cycle.service
[Unit]
Description=Luxembourg AET ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aet
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aet/aet-cycle.log
StandardError=append:/opt/aet/aet-cycle.log
TimeoutStartSec=10800
