[Unit]
Description=ttcaa ingest cycle (discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/ttcaa
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/ttcaa/ttcaa-cycle.log
StandardError=append:/opt/ttcaa/ttcaa-cycle.log
TimeoutStartSec=10800
