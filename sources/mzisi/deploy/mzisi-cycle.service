# /etc/systemd/system/mzisi-cycle.service
[Unit]
Description=MzI (Slovenia) aviation ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/mzisi
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/mzisi/mzisi-cycle.log
StandardError=append:/opt/mzisi/mzisi-cycle.log
TimeoutStartSec=10800
