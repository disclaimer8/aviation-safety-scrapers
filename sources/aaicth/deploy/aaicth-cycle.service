[Unit]
Description=aaicth ingest cycle (discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aaicth
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aaicth/aaicth-cycle.log
StandardError=append:/opt/aaicth/aaicth-cycle.log
TimeoutStartSec=10800
