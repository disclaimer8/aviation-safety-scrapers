# /etc/systemd/system/nsib-cycle.service
[Unit]
Description=NSIB (Nigeria) ingest cycle (weekly; discover->fetch->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/nsib
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/nsib/nsib-cycle.log
StandardError=append:/opt/nsib/nsib-cycle.log
TimeoutStartSec=14400
