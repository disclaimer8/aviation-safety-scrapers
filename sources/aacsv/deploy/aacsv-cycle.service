# /etc/systemd/system/aacsv-cycle.service
[Unit]
Description=El Salvador AAC ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=scraper
WorkingDirectory=/opt/aacsv
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/opt/aacsv/aacsv-cycle.log
StandardError=append:/opt/aacsv/aacsv-cycle.log
TimeoutStartSec=10800
