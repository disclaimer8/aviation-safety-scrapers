# /etc/systemd/system/aacsv-cycle.service
[Unit]
Description=El Salvador AAC ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aacsv-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aacsv-ingest/aacsv-cycle.log
StandardError=append:/home/a1/aacsv-ingest/aacsv-cycle.log
TimeoutStartSec=10800
