# /etc/systemd/system/aaibmn-cycle.service
[Unit]
Description=Mongolia AAIB ingest cycle (weekly; DE-SOCKS discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaibmn-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaibmn-ingest/aaibmn-cycle.log
StandardError=append:/home/a1/aaibmn-ingest/aaibmn-cycle.log
TimeoutStartSec=10800
