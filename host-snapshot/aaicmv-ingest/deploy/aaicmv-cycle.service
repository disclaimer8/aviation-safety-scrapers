# /etc/systemd/system/aaicmv-cycle.service
[Unit]
Description=AAIC Maldives (AICC) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaicmv-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaicmv-ingest/aaicmv-cycle.log
StandardError=append:/home/a1/aaicmv-ingest/aaicmv-cycle.log
TimeoutStartSec=10800
