# /etc/systemd/system/ainhr-cycle.service
[Unit]
Description=AIN.HR (Croatia) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ainhr-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ainhr-ingest/ainhr-cycle.log
StandardError=append:/home/a1/ainhr-ingest/ainhr-cycle.log
TimeoutStartSec=10800
