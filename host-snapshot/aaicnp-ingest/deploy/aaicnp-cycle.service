# /etc/systemd/system/aaicnp-cycle.service
[Unit]
Description=Nepal AAIC (CAAN) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaicnp-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaicnp-ingest/aaicnp-cycle.log
StandardError=append:/home/a1/aaicnp-ingest/aaicnp-cycle.log
TimeoutStartSec=10800
