[Unit]
Description=ttcaa ingest cycle (discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ttcaa-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ttcaa-ingest/ttcaa-cycle.log
StandardError=append:/home/a1/ttcaa-ingest/ttcaa-cycle.log
TimeoutStartSec=10800
