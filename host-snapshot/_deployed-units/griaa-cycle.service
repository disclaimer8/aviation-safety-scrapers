# /etc/systemd/system/griaa-cycle.service
[Unit]
Description=GRIAA (Colombia) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/griaa-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/griaa-ingest/griaa-cycle.log
StandardError=append:/home/a1/griaa-ingest/griaa-cycle.log
TimeoutStartSec=10800
