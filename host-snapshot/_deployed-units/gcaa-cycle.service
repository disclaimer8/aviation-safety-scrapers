# /etc/systemd/system/gcaa-cycle.service
[Unit]
Description=GCAA (UAE) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/gcaa-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/gcaa-ingest/gcaa-cycle.log
StandardError=append:/home/a1/gcaa-ingest/gcaa-cycle.log
TimeoutStartSec=7200
