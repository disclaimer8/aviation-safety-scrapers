# /etc/systemd/system/ttsb-cycle.service
[Unit]
Description=TTSB Taiwan ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ttsb-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ttsb-ingest/ttsb-cycle.log
StandardError=append:/home/a1/ttsb-ingest/ttsb-cycle.log
TimeoutStartSec=7200
