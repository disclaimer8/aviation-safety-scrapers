# /etc/systemd/system/ciaiauy-cycle.service
[Unit]
Description=CIAIA (Uruguay) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ciaiauy-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ciaiauy-ingest/ciaiauy-cycle.log
StandardError=append:/home/a1/ciaiauy-ingest/ciaiauy-cycle.log
TimeoutStartSec=10800
