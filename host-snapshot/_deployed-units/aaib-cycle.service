# /etc/systemd/system/aaib-cycle.service
[Unit]
Description=AAIB (UK) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaib-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaib-ingest/aaib-cycle.log
StandardError=append:/home/a1/aaib-ingest/aaib-cycle.log
TimeoutStartSec=7200
