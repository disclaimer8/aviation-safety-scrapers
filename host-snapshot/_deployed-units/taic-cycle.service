# /etc/systemd/system/taic-cycle.service
[Unit]
Description=TAIC (New Zealand) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/taic-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/taic-ingest/taic-cycle.log
StandardError=append:/home/a1/taic-ingest/taic-cycle.log
TimeoutStartSec=7200
