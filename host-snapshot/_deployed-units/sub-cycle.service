# /etc/systemd/system/sub-cycle.service
[Unit]
Description=SUB Austria ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/sub-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/sub-ingest/sub-cycle.log
StandardError=append:/home/a1/sub-ingest/sub-cycle.log
TimeoutStartSec=7200
