# /etc/systemd/system/bea-cycle.service
[Unit]
Description=BEA (France) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/bfu-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/bfu-ingest/bfu-cycle.log
StandardError=append:/home/a1/bfu-ingest/bfu-cycle.log
TimeoutStartSec=7200
