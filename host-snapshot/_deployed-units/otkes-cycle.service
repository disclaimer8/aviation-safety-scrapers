# /etc/systemd/system/otkes-cycle.service
[Unit]
Description=OTKES (Finland) ingest cycle (weekly; Playwright/Xvfb; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/otkes-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/otkes-ingest/otkes-cycle.log
StandardError=append:/home/a1/otkes-ingest/otkes-cycle.log
TimeoutStartSec=21600
