# /etc/systemd/system/bdca-cycle.service
[Unit]
Description=Belize DCA / BAAI ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/bdca-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/bdca-ingest/bdca-cycle.log
StandardError=append:/home/a1/bdca-ingest/bdca-cycle.log
TimeoutStartSec=10800
