# /etc/systemd/system/ansv-cycle.service
[Unit]
Description=ANSV (Italy) ingest cycle (weekly; discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ansv-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ansv-ingest/ansv-cycle.log
StandardError=append:/home/a1/ansv-ingest/ansv-cycle.log
TimeoutStartSec=10800
