# /etc/systemd/system/dgacgt-cycle.service
[Unit]
Description=DGAC Guatemala (UIA) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/dgacgt-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/dgacgt-ingest/dgacgt-cycle.log
StandardError=append:/home/a1/dgacgt-ingest/dgacgt-cycle.log
TimeoutStartSec=10800
