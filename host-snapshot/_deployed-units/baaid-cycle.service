# /etc/systemd/system/baaid-cycle.service
[Unit]
Description=BAAID (Bahamas) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/baaid-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/baaid-ingest/baaid-cycle.log
StandardError=append:/home/a1/baaid-ingest/baaid-cycle.log
TimeoutStartSec=10800
