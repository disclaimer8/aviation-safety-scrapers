[Unit]
Description=SIBPK Pakistan ingest cycle (weekly; discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/sibpk-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/sibpk-ingest/sibpk-cycle.log
StandardError=append:/home/a1/sibpk-ingest/sibpk-cycle.log
TimeoutStartSec=7200
