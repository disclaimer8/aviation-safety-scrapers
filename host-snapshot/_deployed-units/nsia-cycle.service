# /etc/systemd/system/nsia-cycle.service
[Unit]
Description=NSIA (Norway) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/nsia-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/nsia-ingest/nsia-cycle.log
StandardError=append:/home/a1/nsia-ingest/nsia-cycle.log
TimeoutStartSec=7200
