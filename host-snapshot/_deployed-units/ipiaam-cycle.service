[Unit]
Description=ipiaam ingest cycle (discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ipiaam-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ipiaam-ingest/ipiaam-cycle.log
StandardError=append:/home/a1/ipiaam-ingest/ipiaam-cycle.log
TimeoutStartSec=10800
