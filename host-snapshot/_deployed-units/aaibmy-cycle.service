# /etc/systemd/system/aaibmy-cycle.service
[Unit]
Description=AAIB Malaysia ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaibmy-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaibmy-ingest/aaibmy-cycle.log
StandardError=append:/home/a1/aaibmy-ingest/aaibmy-cycle.log
TimeoutStartSec=7200
