# /etc/systemd/system/sust-cycle.service
[Unit]
Description=SUST STSB (Switzerland) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/sust-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/sust-ingest/sust-cycle.log
StandardError=append:/home/a1/sust-ingest/sust-cycle.log
TimeoutStartSec=14400
