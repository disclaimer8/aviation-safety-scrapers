# /etc/systemd/system/tsb-cycle.service
[Unit]
Description=TSB (Canada) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/tsb-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/tsb-ingest/tsb-cycle.log
StandardError=append:/home/a1/tsb-ingest/tsb-cycle.log
TimeoutStartSec=7200
