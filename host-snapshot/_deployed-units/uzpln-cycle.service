# /etc/systemd/system/uzpln-cycle.service
[Unit]
Description=UZPLN (Czech Republic) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/uzpln-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/uzpln-ingest/uzpln-cycle.log
StandardError=append:/home/a1/uzpln-ingest/uzpln-cycle.log
TimeoutStartSec=7200
