# /etc/systemd/system/aaiu-cycle.service
[Unit]
Description=AAIU (Ireland) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaiu-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaiu-ingest/aaiu-cycle.log
StandardError=append:/home/a1/aaiu-ingest/aaiu-cycle.log
TimeoutStartSec=7200
