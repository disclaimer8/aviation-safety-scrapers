# /etc/systemd/system/aaiube-cycle.service
[Unit]
Description=AAIU (Belgium) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaiube-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaiube-ingest/aaiube-cycle.log
StandardError=append:/home/a1/aaiube-ingest/aaiube-cycle.log
TimeoutStartSec=7200
