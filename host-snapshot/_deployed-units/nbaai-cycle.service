# /etc/systemd/system/nbaai-cycle.service
[Unit]
Description=NBAAI (Ukraine) ingest cycle (weekly; discover->fetch->parse[OCR ukr+rus]->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/nbaai-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/nbaai-ingest/nbaai-cycle.log
StandardError=append:/home/a1/nbaai-ingest/nbaai-cycle.log
TimeoutStartSec=14400
