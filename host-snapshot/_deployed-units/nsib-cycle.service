# /etc/systemd/system/nsib-cycle.service
[Unit]
Description=NSIB (Nigeria) ingest cycle (weekly; discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/nsib-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/nsib-ingest/nsib-cycle.log
StandardError=append:/home/a1/nsib-ingest/nsib-cycle.log
TimeoutStartSec=10800
