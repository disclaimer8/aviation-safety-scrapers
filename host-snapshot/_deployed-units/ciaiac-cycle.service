# /etc/systemd/system/ciaiac-cycle.service
[Unit]
Description=CIAIAC (Spain) ingest cycle (weekly; discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ciaiac-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ciaiac-ingest/ciaiac-cycle.log
StandardError=append:/home/a1/ciaiac-ingest/ciaiac-cycle.log
TimeoutStartSec=10800
