# /etc/systemd/system/aaiib-cycle.service
[Unit]
Description=AAIIB (Philippines) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaiib-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaiib-ingest/aaiib-cycle.log
StandardError=append:/home/a1/aaiib-ingest/aaiib-cycle.log
TimeoutStartSec=10800
