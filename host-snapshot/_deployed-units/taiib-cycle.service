# /etc/systemd/system/taiib-cycle.service
[Unit]
Description=TAIIB (Latvia) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/taiib-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/taiib-ingest/taiib-cycle.log
StandardError=append:/home/a1/taiib-ingest/taiib-cycle.log
TimeoutStartSec=10800
