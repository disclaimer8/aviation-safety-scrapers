# /etc/systemd/system/dgaccl-cycle.service
[Unit]
Description=DGAC Chile ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/dgaccl-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/dgaccl-ingest/dgaccl-cycle.log
StandardError=append:/home/a1/dgaccl-ingest/dgaccl-cycle.log
TimeoutStartSec=7200
