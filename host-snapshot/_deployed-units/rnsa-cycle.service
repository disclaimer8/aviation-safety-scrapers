# /etc/systemd/system/rnsa-cycle.service
[Unit]
Description=RNSA Iceland (aviation) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/rnsa-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/rnsa-ingest/rnsa-cycle.log
StandardError=append:/home/a1/rnsa-ingest/rnsa-cycle.log
TimeoutStartSec=7200
