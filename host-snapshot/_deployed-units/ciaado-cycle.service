# /etc/systemd/system/ciaado-cycle.service
[Unit]
Description=CIAA (Dominican Republic) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ciaado-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ciaado-ingest/ciaado-cycle.log
StandardError=append:/home/a1/ciaado-ingest/ciaado-cycle.log
TimeoutStartSec=10800
