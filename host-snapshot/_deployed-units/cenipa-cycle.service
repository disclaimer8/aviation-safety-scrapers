# /etc/systemd/system/cenipa-cycle.service
[Unit]
Description=CENIPA (Brazil) ingest cycle (weekly; Playwright/Xvfb; discover->fetch->parse->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/cenipa-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/cenipa-ingest/cenipa-cycle.log
StandardError=append:/home/a1/cenipa-ingest/cenipa-cycle.log
TimeoutStartSec=21600
