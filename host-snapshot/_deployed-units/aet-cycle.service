# /etc/systemd/system/aet-cycle.service
[Unit]
Description=Luxembourg AET ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aet-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aet-ingest/aet-cycle.log
StandardError=append:/home/a1/aet-ingest/aet-cycle.log
TimeoutStartSec=10800
