# /etc/systemd/system/aibdk-cycle.service
[Unit]
Description=AIB Denmark ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aibdk-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aibdk-ingest/aibdk-cycle.log
StandardError=append:/home/a1/aibdk-ingest/aibdk-cycle.log
TimeoutStartSec=14400
