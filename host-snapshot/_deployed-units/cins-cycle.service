# /etc/systemd/system/cins-cycle.service
[Unit]
Description=CINS (Serbia) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/cins-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/cins-ingest/cins-cycle.log
StandardError=append:/home/a1/cins-ingest/cins-cycle.log
TimeoutStartSec=10800
