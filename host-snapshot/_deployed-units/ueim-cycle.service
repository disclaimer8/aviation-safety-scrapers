# /etc/systemd/system/ueim-cycle.service
[Unit]
Description=UEIM Turkey ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/ueim-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/ueim-ingest/ueim-cycle.log
StandardError=append:/home/a1/ueim-ingest/ueim-cycle.log
TimeoutStartSec=7200
