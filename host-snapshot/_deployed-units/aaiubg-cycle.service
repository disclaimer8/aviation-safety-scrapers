# /etc/systemd/system/aaiubg-cycle.service
[Unit]
Description=Bulgaria AAIU (aaiubg) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaiubg-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaiubg-ingest/aaiubg-cycle.log
StandardError=append:/home/a1/aaiubg-ingest/aaiubg-cycle.log
TimeoutStartSec=10800
