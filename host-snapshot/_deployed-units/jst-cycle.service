# /etc/systemd/system/jst-cycle.service
[Unit]
Description=JST (Argentina) ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/jst-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/jst-ingest/jst-cycle.log
StandardError=append:/home/a1/jst-ingest/jst-cycle.log
TimeoutStartSec=7200
