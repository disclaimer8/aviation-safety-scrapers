# /etc/systemd/system/aicpng-cycle.service
[Unit]
Description=AIC PNG (Papua New Guinea) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aicpng-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aicpng-ingest/aicpng-cycle.log
StandardError=append:/home/a1/aicpng-ingest/aicpng-cycle.log
TimeoutStartSec=10800
