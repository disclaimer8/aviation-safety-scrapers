# /etc/systemd/system/eccaa-cycle.service
[Unit]
Description=ECCAA (Eastern Caribbean CAA) ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/eccaa-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/eccaa-ingest/eccaa-cycle.log
StandardError=append:/home/a1/eccaa-ingest/eccaa-cycle.log
TimeoutStartSec=10800
