# /etc/systemd/system/araib-cycle.service
[Unit]
Description=ARAIB South Korea ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/araib-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/araib-ingest/araib-cycle.log
StandardError=append:/home/a1/araib-ingest/araib-cycle.log
TimeoutStartSec=7200
