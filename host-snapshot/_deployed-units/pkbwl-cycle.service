# /etc/systemd/system/pkbwl-cycle.service
[Unit]
Description=PKBWL Poland ingest cycle (weekly; discover->fetch->build->sync)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/pkbwl-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/pkbwl-ingest/pkbwl-cycle.log
StandardError=append:/home/a1/pkbwl-ingest/pkbwl-cycle.log
TimeoutStartSec=14400
