# /etc/systemd/system/aaibzm-cycle.service
[Unit]
Description=AAIB Zambia ingest cycle (weekly; discover->fetch->parse->build)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=a1
WorkingDirectory=/home/a1/aaibzm-ingest
ExecStart=/bin/bash -lc "deploy/run-cycle.sh"
StandardOutput=append:/home/a1/aaibzm-ingest/aaibzm-cycle.log
StandardError=append:/home/a1/aaibzm-ingest/aaibzm-cycle.log
TimeoutStartSec=10800
